{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityatlas.local/schema/atlas-manifest.schema.json",
  "title": "AtlasManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportVersion",
    "dataOrigin",
    "generatedAtUtc",
    "tenant",
    "coverage",
    "security",
    "counts",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reportVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataOrigin": {
      "enum": [
        "LiveTenant",
        "SampleFixture"
      ]
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "warnings",
        "collectors"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectors": {
          "type": "array"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnlyCollection",
        "tokenDataSerialized",
        "browserNetworkAccess",
        "localServerBinding",
        "containsTenantData"
      ],
      "properties": {
        "readOnlyCollection": {
          "const": true
        },
        "tokenDataSerialized": {
          "const": false
        },
        "browserNetworkAccess": {
          "const": "disabled"
        },
        "localServerBinding": {
          "const": "loopbackOnly"
        },
        "containsTenantData": {
          "type": "boolean"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "evidence"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
